import { joinURL, withTrailingSlash } from "ufo";

import Layout from "../layouts/Layout.astro";
import { PRODUCTION_BASE_URL } from "../lib/info.js";

const { BASE_URL } = import.meta.env;
---

<Layout
  lang="en"
  title="macOS is not supported"
  description="BGOBS does not support macOS and does not publish a macOS package."
  canonical={joinURL(PRODUCTION_BASE_URL, "macos")}
>
  <main id="main-content" class="content-panel prose">
    <p class="eyebrow">macOS</p>
    <h1>macOS is not supported</h1>
    <p class="lede">
      BGOBS publishes packages for Windows x64 and Ubuntu x86_64 only. No macOS
      package is built, tested, or released.
    </p>

    <aside class="callout">
      <p>
        <strong>There is no official macOS download.</strong> Do not use a package
        presented elsewhere as an official BGOBS release.
      </p>
    </aside>

    <nav class="page-nav" aria-label="Page navigation">
      <a href={withTrailingSlash(BASE_URL)}>BGOBS home</a>
    </nav>
  </main>
</Layout>
